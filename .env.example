# Environment Configuration Template
#
# This project uses 2 environment files:
#   .env.development  →  Local development & tests (Docker database)
#   .env.production   →  Local production testing (Neon database)
#
# Scripts in package.json automatically load the correct file.
# For Vercel deployments, set variables in Vercel Dashboard (not files).

# ============================================================================
# FOR .env.development (Local Development & Tests)
# ============================================================================
# Copy this section to .env.development and update with your Docker credentials

DATABASE_URL="postgresql://user:password@localhost:5432/opustrack?schema=public"
# Scratch database for `npm run db:drift` (migration drift check). Prisma
# creates it automatically; it never holds real data.
SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/opustrack_shadow?schema=public"
NEXTAUTH_SECRET="dev-secret-not-for-production"
NEXTAUTH_URL="http://localhost:3000"
FILE_STORAGE_PROVIDER="filesystem"
# Shared secret for GET /api/cron/notifications (Vercel Cron sends it as
# `Authorization: Bearer <secret>`; `npm run cron:notifications` reads it from
# here). Generate one with `openssl rand -hex 32` and set the same value in
# Vercel Dashboard for production. Calls without it get a generic 401.
CRON_SECRET="dev-cron-secret-not-for-production"

# ============================================================================
# FOR .env.production (Local Production Testing ONLY)
# ============================================================================
# Copy this section to .env.production for local production builds
# NOT used by Vercel - Vercel uses Dashboard environment variables

# DATABASE_URL="postgresql://your-neon-connection-string"
# NEXTAUTH_SECRET="<generate-with-openssl-rand-base64-32>"
# NEXTAUTH_URL="https://your-domain.com"
# FILE_STORAGE_PROVIDER="vercel-blob"
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxx"

# ============================================================================
# FOR VERCEL DASHBOARD (Actual Production Deployment)
# ============================================================================
# Set these in: Vercel Project → Settings → Environment Variables
#
#   DATABASE_URL          - Your Neon production database URL
#   NEXTAUTH_SECRET       - Strong secret (generate: openssl rand -base64 32)
#   NEXTAUTH_URL          - Your production domain (e.g., https://app.example.com)
#   CRON_SECRET           - Shared secret for /api/cron/notifications
#                           (generate: openssl rand -hex 32)
#   FILE_STORAGE_PROVIDER - vercel-blob
#   BLOB_READ_WRITE_TOKEN - Get from Vercel Dashboard → Storage
