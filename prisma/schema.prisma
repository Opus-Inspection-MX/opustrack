// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String                   @id @default(cuid())
  name                String
  email               String                   @unique
  password            String
  userStatusId        Int                      @default(1)
  clienteId               String? // Deprecated - kept for backward compatibility (use clienteAssignments instead)
  clienteIds              String[]                 @default([]) // Deprecated - use clienteAssignments instead
  sessionVersion      Int                      @default(1) // Increment to invalidate all user sessions
  // A user holds MANY roles: someone can administer vacations, administer
  // operations, and still be an FSR who gets dispatched. There is deliberately
  // no `roleId` scalar beside this: `clienteId` was left as a "deprecated"
  // scalar next to `clienteAssignments` and the read paths kept using it while
  // writes went to the join table, so editing a user's Cliente silently saved
  // nothing. One source of truth.
  userRoles           UserRole[]
  userStatus          UserStatus               @relation(fields: [userStatusId], references: [id])
  userProfile         UserProfile?
  cliente                 Cliente? @relation(fields: [clienteId], references: [id])
  clienteAssignments      UserClienteAssignment[] // Cliente assignments for this user
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  assignmentAssignees AssignmentAssignee[] // Assignments this user is assigned to (M-N)
  incidentAssignees   IncidentAssignee[] // Incidents this user is enabled to work on (RF-025)
  assignmentsSeen     Assignment[]             @relation("AssignmentSeenBy") // Assignments first acknowledged ("visto") by this user
  reportedIncidents   Incident[]               @relation("IncidentReporter")
  incidents           Incident[]               @relation("IncidentUser") // relación opcional si usas userId en Incident
  vehicleTrips        VehicleTrip[] // Vehicle trips driven by this FSR
  assignedVehicles    Vehicle[]                @relation("AssignedVehicles") // Vehicles assigned to this FSR
  notifications       Notification[] // User's notifications
  vacations           Vacation[]               @relation("VacationUser") // Vacation requests owned by this user (RF-701)
  approvedVacations   Vacation[]               @relation("VacationApprover") // Vacations approved/rejected by this user (RF-702)
  // Nullable: users created before vacation balances existed have no hire date.
  // Balance features stay blocked (with a clear message) until an admin sets it.
  hireDate            DateTime?
  vacationPeriods     VacationPeriod[]         @relation("VacationPeriodUser")
  active              Boolean                  @default(true)
}

model UserClienteAssignment {
  id        String   @id @default(cuid())
  userId    String
  clienteId     String
  isPrimary Boolean  @default(false) // Primary Cliente for the user
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  cliente  Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([userId, clienteId])
  @@index([userId])
  @@index([clienteId])
}

/// Roles a user holds. A user with several roles gets the UNION of their
/// permissions, and lands on the `defaultPath` of the highest-priority one.
model UserRole {
  id        Int      @id @default(autoincrement())
  userId    String
  roleId    Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([userId, active])
  @@index([roleId])
  @@map("user_roles")
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  defaultPath String
  /// Bypasses every route and permission check. ROOT only.
  ///
  /// This replaced the hardcoded `role.name === "ADMINISTRADOR"` check. The old
  /// name meant four different things at once — bypass, cross-Cliente data
  /// scope, ownership override, and notification audience — and only the first
  /// one belongs to a superuser. The other three are permissions now, so an
  /// operations admin can see every Cliente without being able to grant roles.
  isSuperuser Boolean @default(false)
  /// Higher wins when a multi-role user needs one landing page.
  priority    Int     @default(0)

  userRoles      UserRole[]
  rolePermission RolePermission[]
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt
}

model Permission {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  resource    String? // e.g., "incidents", "users", "assignments"
  action      String? // e.g., "read", "create", "update", "delete"
  routePath   String? // e.g., "/admin", "/incidents", "/fsr"
  /// Match `routePath` by equality instead of by prefix.
  ///
  /// Route coverage is prefix-based, so granting `/admin` grants the whole
  /// panel. A module admin needs the `/admin` landing page WITHOUT inheriting
  /// `/admin/incidents`, and that is the only way to express it.
  exact       Boolean          @default(false)
  roles       RolePermission[]
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt

  @@index([resource, action])
  @@index([routePath])
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  active       Boolean    @default(true)

  @@unique([roleId, permissionId])
}

model UserStatus {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  users  User[]
  active Boolean @default(true)
}

model UserProfile {
  id                 Int      @id @default(autoincrement())
  userId             String   @unique
  telephone          String?
  secondaryTelephone String?
  emergencyContact   String?
  jobPosition        String?
  user               User     @relation(fields: [userId], references: [id])
  updatedAt          DateTime @updatedAt
  active             Boolean  @default(true)
}

model Cliente {
  id              String              @id @default(cuid())
  code            String              @unique
  name            String
  address         String?
  rfc             String?
  companyName     String?
  phone           String?
  contact         String?
  email           String?
  stateId         Int
  state           State               @relation(fields: [stateId], references: [id])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  users           User[] // Deprecated - use userAssignments instead
  userAssignments UserClienteAssignment[] // User assignments for this Cliente
  scheduleClientes    ScheduleCliente[]
  incidents       Incident[]
  lines           Line[]
  active          Boolean             @default(true)
}

model State {
  id                       Int                       @id @default(autoincrement())
  name                     String                    @unique
  code                     String                    @unique
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  clientes                 Cliente[]
  active                   Boolean                   @default(true)
}

model Schedule {
  id          String          @id @default(cuid())
  title       String
  description String?
  scheduledAt DateTime // Fecha de inicio
  endDate     DateTime? // Fecha de fin (opcional)
  statusId    Int? // Estado del schedule
  status      ScheduleStatus? @relation(fields: [statusId], references: [id])
  clientes        ScheduleCliente[]
  incidents   Incident[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  active      Boolean         @default(true)

  @@index([statusId])
  @@index([scheduledAt])
  @@index([endDate])
}

model ScheduleCliente {
  scheduleId String
  clienteId      String
  schedule   Schedule                @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  cliente        Cliente @relation(fields: [clienteId], references: [id])
  active     Boolean                 @default(true)
  createdAt  DateTime                @default(now())

  @@id([scheduleId, clienteId])
  @@index([clienteId])
  @@index([scheduleId])
}

model ScheduleStatus {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  color       String     @default("#6B7280") // Hexadecimal color for status badge
  schedules   Schedule[]
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model IncidentType {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  priority    Int        @default(5)
  incidents   Incident[]
  active      Boolean    @default(true)
}

model IncidentStatus {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  color     String     @default("#6B7280") // Hexadecimal color for status badge
  incidents Incident[]
  active    Boolean    @default(true)
}

model AssignmentStatus {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  color       String       @default("#6B7280")
  assignments Assignment[]
  active      Boolean      @default(true)
}

model LineStatus {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  lines  Line[]
  active Boolean @default(true)
}

model EquipmentStatus {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  equipments Equipment[]
  active     Boolean     @default(true)
}

model VehicleStatus {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  vehicles Vehicle[]
  active   Boolean   @default(true)
}

model VehicleTripStatus {
  id     Int           @id @default(autoincrement())
  name   String        @unique
  trips  VehicleTrip[]
  active Boolean       @default(true)
}

model Incident {
  id           Int                      @id @default(autoincrement())
  title        String
  description  String
  typeId       Int
  type         IncidentType             @relation(fields: [typeId], references: [id])
  statusId     Int?
  status       IncidentStatus?          @relation(fields: [statusId], references: [id])
  reportedAt   DateTime                 @default(now())
  startedAt    DateTime?
  resolvedAt   DateTime?
  cancelledAt  DateTime?
  cancellationReason String?
  clienteId        String?
  cliente          Cliente? @relation(fields: [clienteId], references: [id])
  reportedById String?
  reportedBy   User?                    @relation("IncidentReporter", fields: [reportedById], references: [id])
  /// Free text: the actual person who raised it.
  ///
  /// A center's account is shared by everyone who works there, so `reportedBy`
  /// identifies the center, not a human. This is deliberately NOT a User
  /// relation — the people typing it have no accounts of their own.
  reporterName String?
  scheduleId   String?
  schedule     Schedule?                @relation(fields: [scheduleId], references: [id])
  lineId       Int?
  line         Line?                    @relation(fields: [lineId], references: [id])
  equipmentId  Int?
  equipment    Equipment?               @relation(fields: [equipmentId], references: [id])

  // userId estaba huérfano: definimos relación opcional clara
  userId String?
  user   User?   @relation("IncidentUser", fields: [userId], references: [id])

  assignments Assignment[]
  assignees   IncidentAssignee[] // RF-025: FSRs habilitados para este incidente
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  active      Boolean            @default(true)

  @@index([clienteId])
  @@index([statusId])
  @@index([typeId])
  @@index([reportedById])
  @@index([lineId])
  @@index([equipmentId])
  @@index([reportedAt]) // Optimize date range queries in tracking
  @@index([active, reportedAt]) // Compound index for active incidents ordered by date
}

model IncidentAssignee {
  id         String   @id @default(cuid())
  incidentId Int
  userId     String
  assignedAt DateTime @default(now())
  active     Boolean  @default(true)

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([incidentId, userId])
  @@index([userId])
  @@index([incidentId])
  @@index([active, userId])
  @@map("incident_assignees")
}

model Assignment {
  id                   String                 @id @default(cuid())
  incidentId           Int
  incident             Incident               @relation(fields: [incidentId], references: [id])
  assignees            AssignmentAssignee[] // Multiple FSRs per assignment (M-N)
  statusId             Int?
  status               AssignmentStatus?      @relation(fields: [statusId], references: [id])
  notes                String?
  folio                Int                    @unique @default(autoincrement()) // Auto-generated numeric folio
  odtFolio             String? // ODT folio captured from external system (RF-010)
  startedAt            DateTime?
  finishedAt           DateTime?
  // Renamed from unlockedAt — "Visto" state machine: when FSR first acknowledged.
  seenAt               DateTime?
  seenById             String?
  seenBy               User?                  @relation("AssignmentSeenBy", fields: [seenById], references: [id])
  assignedAt           DateTime? // When assignment was assigned (for time-to-seen calculation)
  // GPS captured when transitioning to INICIADO (start of on-site work)
  startLatitude        Float?
  startLongitude       Float?
  startAddress         String?
  // GPS captured when transitioning to CERRADO (end of on-site work)
  endLatitude          Float?
  endLongitude         Float?
  endAddress           String?
  assignmentActivities AssignmentActivity[]
  attachments          AssignmentAttachment[]
  workParts            WorkPart[]
  vehicleTrips         VehicleTrip[] // Vehicle trips linked to this assignment
  scheduledDate        DateTime? // Optional scheduled date for FSR availability check (RF-708)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  active               Boolean                @default(true)

  @@index([incidentId])
  @@index([statusId])
  @@index([active, createdAt]) // Compound index for active assignments ordered by date
  @@index([seenAt]) // Optimize filtering by seen status
  @@index([seenById])
  @@index([scheduledDate])
}

model AssignmentAssignee {
  id           String   @id @default(cuid())
  assignmentId String
  userId       String
  assignedAt   DateTime @default(now())
  active       Boolean  @default(true)

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])

  @@unique([assignmentId, userId])
  @@index([userId])
  @@index([assignmentId])
  @@index([active, userId])
  @@map("assignment_assignees")
}

model AssignmentActivity {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  description  String
  performedAt  DateTime   @default(now())
  workParts    WorkPart[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  active       Boolean    @default(true)

  @@index([assignmentId])
}

model AssignmentAttachment {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  filename     String
  filepath     String
  mimetype     String
  size         Int
  description  String?
  provider     String     @default("vercel-blob") // "vercel-blob" or "filesystem"
  uploadedAt   DateTime   @default(now())
  active       Boolean    @default(true)

  @@index([assignmentId])
}

model Part {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  price       Float
  stock       Int
  workParts   WorkPart[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  active      Boolean    @default(true)
}

model WorkPart {
  id           String              @id @default(cuid())
  partId       String
  part         Part                @relation(fields: [partId], references: [id])
  quantity     Int
  description  String?
  price        Float
  assignmentId String?
  assignment   Assignment?         @relation(fields: [assignmentId], references: [id])
  activityId   String?
  activity     AssignmentActivity? @relation(fields: [activityId], references: [id])
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  active       Boolean             @default(true)

  @@index([assignmentId])
  @@index([activityId])
}

model Line {
  id          Int                     @id @default(autoincrement())
  name        String
  description String?
  statusId    Int                     @default(1)
  status      LineStatus              @relation(fields: [statusId], references: [id])
  clienteId       String
  cliente         Cliente @relation(fields: [clienteId], references: [id])
  equipments  Equipment[]
  incidents   Incident[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  active      Boolean                 @default(true)

  @@unique([name, clienteId])
  @@index([clienteId])
  @@index([statusId])
}

model Equipment {
  id           Int             @id @default(autoincrement())
  name         String
  description  String?
  model        String?
  serialNumber String?
  statusId     Int             @default(1)
  status       EquipmentStatus @relation(fields: [statusId], references: [id])
  lineId       Int
  line         Line            @relation(fields: [lineId], references: [id])
  incidents    Incident[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  active       Boolean         @default(true)

  @@index([lineId])
  @@index([statusId])
  @@index([serialNumber])
}

model Vehicle {
  id            String        @id @default(cuid())
  make          String // e.g., "Toyota"
  model         String // e.g., "Corolla"
  year          Int // e.g., 2023
  licensePlate  String        @unique // e.g., "ABC-123-XYZ"
  vin           String?       @unique // Vehicle Identification Number (optional)
  color         String? // e.g., "White"
  statusId      Int           @default(1) // Status ID reference
  status        VehicleStatus @relation(fields: [statusId], references: [id])
  assignedFsrId String? // FSR currently assigned to this vehicle
  assignedFsr   User?         @relation("AssignedVehicles", fields: [assignedFsrId], references: [id])
  notes         String? // General notes about vehicle
  active        Boolean       @default(true) // Soft delete
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  trips         VehicleTrip[]

  @@index([licensePlate])
  @@index([statusId])
  @@index([assignedFsrId])
  @@index([active])
}

model VehicleTrip {
  id                 String            @id @default(cuid())
  vehicleId          String
  vehicle            Vehicle           @relation(fields: [vehicleId], references: [id])
  fsrId              String // FSR who drove
  fsr                User              @relation(fields: [fsrId], references: [id])
  assignmentId       String? // Optional assignment link
  assignment         Assignment?       @relation(fields: [assignmentId], references: [id])
  // Start data
  startOdometer      Int // Start reading in kilometers
  startPhotoUrl      String // Photo of start odometer
  startPhotoProvider String            @default("vercel-blob")
  startLatitude      Float? // GPS latitude
  startLongitude     Float? // GPS longitude
  startAddress       String? // Optional manual address
  startedAt          DateTime          @default(now())
  // End data (nullable until trip ends)
  endOdometer        Int? // End reading in kilometers
  endPhotoUrl        String? // Photo of end odometer
  endPhotoProvider   String?
  endLatitude        Float? // GPS latitude
  endLongitude       Float? // GPS longitude
  endAddress         String? // Optional manual address
  endedAt            DateTime?
  // Calculated
  kmDriven           Int? // Calculated: endOdometer - startOdometer
  // Metadata
  notes              String? // Trip notes
  statusId           Int               @default(1) // Status ID reference
  status             VehicleTripStatus @relation(fields: [statusId], references: [id])
  active             Boolean           @default(true) // Soft delete
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([vehicleId])
  @@index([fsrId])
  @@index([assignmentId])
  @@index([statusId])
  @@index([startedAt])
  @@index([active])
}

model Notification {
  id     String @id @default(cuid())
  userId String // Recipient user ID
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Notification content
  title   String // e.g., "Nueva Asignación"
  message String // e.g., "Se le ha asignado la asignación..."
  type    String // e.g., "assignment_assigned", "incident_updated"

  // Related entity (polymorphic approach)
  entityType String? // e.g., "assignment", "incident", "user"
  entityId   String? // ID of the related entity
  actionUrl  String? // URL to navigate when clicked

  // Status
  isRead Boolean   @default(false)
  readAt DateTime?

  // Metadata
  priority Int   @default(1) // 1=low, 2=medium, 3=high
  metadata Json? // Additional flexible data

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  active    Boolean  @default(true) // Soft delete

  @@index([userId, isRead]) // Fast unread count queries
  @@index([userId, createdAt]) // Fast "recent notifications" queries
  @@index([type]) // Filter by notification type
  @@index([active, createdAt]) // Cleanup queries
}

// ─── Holidays & Vacations (RF-700–RF-749) ────────────────────────────────────

/// Official non-working day rule (LFT Art. 74).
/// A rule is either a fixed date (month+day), an n-th Monday (month+nthMonday),
/// or a one-time sexennial event (isRecurring:false + year).
/// XOR(day, nthMonday) — exactly one must be set.
model Holiday {
  id          Int     @id @default(autoincrement())
  name        String
  /// Calendar month (1=Jan … 12=Dec). Always required.
  month       Int
  /// Day-of-month for fixed-date holidays. Null for n-th-Monday rules.
  day         Int?
  /// Which Monday of the month (1=first, 3=third). Null for fixed-date rules.
  nthMonday   Int?
  /// True for annually recurring holidays. False for one-time events (requires year).
  isRecurring Boolean @default(true)
  /// The specific year for one-time (sexennial) events. Null for recurring rules.
  year        Int?
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([month])
  @@map("holidays")
}

/// Status catalog for vacation requests — follows ScheduleStatus pattern.
/// Seed values: PENDIENTE, APROBADA, RECHAZADA.
model VacationStatus {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  color       String    @default("#6B7280")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  vacations   Vacation[]

  @@map("vacation_statuses")
}

/// FSR absence / vacation period request (RF-701, RF-702).
/// Date range is inclusive; stored as UTC instants representing CDMX start/end of day.
model Vacation {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation("VacationUser", fields: [userId], references: [id])
  startDate    DateTime
  endDate      DateTime
  reason       String?
  statusId     Int
  status       VacationStatus @relation(fields: [statusId], references: [id])
  approvedById String?
  approvedBy   User?          @relation("VacationApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  // Nullable because rows created before the balance system have no period to
  // backfill from (there was no hireDate to derive one). Every new request
  // resolves one; see resolveVacationPeriod.
  periodId         String?
  period           VacationPeriod? @relation(fields: [periodId], references: [id])
  // Business days this request consumes, snapshotted at creation. Snapshotting
  // keeps history stable if the Holiday catalog is edited afterwards.
  businessDaysUsed Int?
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([userId])
  @@index([statusId])
  @@index([userId, startDate, endDate])
  @@index([active, userId])
  @@index([periodId])
  @@map("vacations")
}

/// Days-of-entitlement table by years of service (LFT Art. 76, 2023 reform).
/// A catalog rather than hardcoded constants so the rules can be corrected from
/// the admin UI if the law changes. Resolution: the row where
/// minYears <= yearsOfService <= (maxYears ?? infinity).
model VacationAccrualRule {
  id        Int      @id @default(autoincrement())
  minYears  Int      @unique // inclusive lower bound, in completed years of service
  maxYears  Int? // inclusive upper bound; null = open-ended final tier
  days      Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@map("vacation_accrual_rules")
}

/// Singleton configuration row (id is pinned to 1). `graceWindowMonths` is how
/// long days stay usable AFTER their accrual year closes (LFT Art. 81 grace
/// window); the law says 6, the business default here is 12.
model VacationSetting {
  id                Int      @id @default(1)
  graceWindowMonths Int      @default(12)
  updatedAt         DateTime @updatedAt

  @@map("vacation_settings")
}

/// One anniversary year of service per user.
///
/// `accrualStart`/`accrualEnd`/`graceEnd`/`ruleDays` are SNAPSHOTS taken when
/// the row is created: editing the accrual table or the grace-window setting
/// must never retroactively resize a period someone already has approved
/// vacations inside.
///
/// There is deliberately no `remainingDays` column — the balance is always
/// derived (see getPeriodBalance), so raising `overrideDays` can only ever
/// increase what is available and can never orphan an existing request.
model VacationPeriod {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation("VacationPeriodUser", fields: [userId], references: [id], onDelete: Cascade)
  periodNumber Int // 1-based; equals the year of service used for rule lookup
  accrualStart DateTime // hireDate + (periodNumber - 1) years, CDMX start of day
  accrualEnd   DateTime // accrualStart + 1 year - 1 day, CDMX end of day
  graceEnd     DateTime // accrualEnd + graceWindowMonths as it stood at creation
  ruleDays     Int // snapshot of the matching VacationAccrualRule.days
  overrideDays Int? // admin correction; replaces ruleDays when present
  vacations    Vacation[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([userId, periodNumber])
  @@index([userId])
  @@index([accrualStart, graceEnd])
  @@map("vacation_periods")
}
