// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String                   @id @default(cuid())
  name              String
  email             String                   @unique
  password          String
  roleId            Int
  userStatusId      Int                      @default(1)
  vicId             String? // Deprecated - kept for backward compatibility (use vicAssignments instead)
  vicIds            String[]                 @default([]) // Deprecated - use vicAssignments instead
  sessionVersion    Int                      @default(1) // Increment to invalidate all user sessions
  role              Role                     @relation(fields: [roleId], references: [id])
  userStatus        UserStatus               @relation(fields: [userStatusId], references: [id])
  userProfile       UserProfile?
  vic               VehicleInspectionCenter? @relation(fields: [vicId], references: [id])
  vicAssignments    UserVicAssignment[] // VIC assignments for this user
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  assignments       Assignment[]
  reportedIncidents Incident[]               @relation("IncidentReporter")
  incidents         Incident[]               @relation("IncidentUser") // relación opcional si usas userId en Incident
  vehicleTrips      VehicleTrip[] // Vehicle trips driven by this FSR
  assignedVehicles  Vehicle[]                @relation("AssignedVehicles") // Vehicles assigned to this FSR
  notifications     Notification[] // User's notifications
  active            Boolean                  @default(true)
}

model UserVicAssignment {
  id        String   @id @default(cuid())
  userId    String
  vicId     String
  isPrimary Boolean  @default(false) // Primary VIC for the user
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vic  VehicleInspectionCenter @relation(fields: [vicId], references: [id], onDelete: Cascade)

  @@unique([userId, vicId])
  @@index([userId])
  @@index([vicId])
}

model Role {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  description    String?
  defaultPath    String
  users          User[]
  rolePermission RolePermission[]
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt
}

model Permission {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  resource    String? // e.g., "incidents", "users", "assignments"
  action      String? // e.g., "read", "create", "update", "delete"
  routePath   String? // e.g., "/admin", "/incidents", "/fsr"
  roles       RolePermission[]
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt

  @@index([resource, action])
  @@index([routePath])
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  active       Boolean    @default(true)

  @@unique([roleId, permissionId])
}

model UserStatus {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  users  User[]
  active Boolean @default(true)
}

model UserProfile {
  id                 Int      @id @default(autoincrement())
  userId             String   @unique
  telephone          String?
  secondaryTelephone String?
  emergencyContact   String?
  jobPosition        String?
  user               User     @relation(fields: [userId], references: [id])
  updatedAt          DateTime @updatedAt
  active             Boolean  @default(true)
}

model VehicleInspectionCenter {
  id              String              @id @default(cuid())
  code            String              @unique
  name            String
  address         String?
  rfc             String?
  companyName     String?
  phone           String?
  contact         String?
  email           String?
  stateId         Int
  state           State               @relation(fields: [stateId], references: [id])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  users           User[] // Deprecated - use userAssignments instead
  userAssignments UserVicAssignment[] // User assignments for this VIC
  schedules       Schedule[]
  incidents       Incident[]
  lines           Line[]
  active          Boolean             @default(true)
}

model State {
  id                       Int                       @id @default(autoincrement())
  name                     String                    @unique
  code                     String                    @unique
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  vehicleInspectionCenters VehicleInspectionCenter[]
  active                   Boolean                   @default(true)
}

model Schedule {
  id          String                  @id @default(cuid())
  title       String
  description String?
  scheduledAt DateTime // Fecha de inicio
  endDate     DateTime? // Fecha de fin (opcional)
  statusId    Int? // Estado del schedule
  status      ScheduleStatus?         @relation(fields: [statusId], references: [id])
  vicId       String
  vic         VehicleInspectionCenter @relation(fields: [vicId], references: [id])
  incidents   Incident[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  active      Boolean                 @default(true)

  @@index([statusId])
  @@index([scheduledAt])
  @@index([endDate])
}

model ScheduleStatus {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  color       String     @default("#6B7280") // Hexadecimal color for status badge
  schedules   Schedule[]
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model IncidentType {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  incidents   Incident[]
  active      Boolean    @default(true)
}

model IncidentStatus {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  color     String     @default("#6B7280") // Hexadecimal color for status badge
  incidents Incident[]
  active    Boolean    @default(true)
}

model AssignmentStatus {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  color       String       @default("#6B7280")
  assignments Assignment[]
  active      Boolean      @default(true)
}

model LineStatus {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  lines  Line[]
  active Boolean @default(true)
}

model EquipmentStatus {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  equipments Equipment[]
  active     Boolean     @default(true)
}

model VehicleStatus {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  vehicles Vehicle[]
  active   Boolean   @default(true)
}

model VehicleTripStatus {
  id     Int           @id @default(autoincrement())
  name   String        @unique
  trips  VehicleTrip[]
  active Boolean       @default(true)
}

model Incident {
  id           Int                      @id @default(autoincrement())
  title        String
  description  String
  priority     Int
  sla          Int
  typeId       Int?
  type         IncidentType?            @relation(fields: [typeId], references: [id])
  statusId     Int?
  status       IncidentStatus?          @relation(fields: [statusId], references: [id])
  reportedAt   DateTime                 @default(now())
  resolvedAt   DateTime?
  vicId        String?
  vic          VehicleInspectionCenter? @relation(fields: [vicId], references: [id])
  reportedById String?
  reportedBy   User?                    @relation("IncidentReporter", fields: [reportedById], references: [id])
  scheduleId   String?
  schedule     Schedule?                @relation(fields: [scheduleId], references: [id])
  lineId       Int?
  line         Line?                    @relation(fields: [lineId], references: [id])
  equipmentId  Int?
  equipment    Equipment?               @relation(fields: [equipmentId], references: [id])

  // userId estaba huérfano: definimos relación opcional clara
  userId String?
  user   User?   @relation("IncidentUser", fields: [userId], references: [id])

  assignments Assignment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  active      Boolean      @default(true)

  @@index([vicId])
  @@index([statusId])
  @@index([typeId])
  @@index([reportedById])
  @@index([lineId])
  @@index([equipmentId])
  @@index([reportedAt]) // Optimize date range queries in tracking
  @@index([active, reportedAt]) // Compound index for active incidents ordered by date
}

model Assignment {
  id                   String                 @id @default(cuid())
  incidentId           Int
  incident             Incident               @relation(fields: [incidentId], references: [id])
  assignedToId         String
  assignedTo           User                   @relation(fields: [assignedToId], references: [id])
  statusId             Int?
  status               AssignmentStatus?      @relation(fields: [statusId], references: [id])
  notes                String?
  folio                Int       @unique @default(dbgenerated("nextval('assignment_folio_seq')")) // Auto-generated numeric folio
  startedAt            DateTime?
  finishedAt           DateTime?
  unlockedAt           DateTime? // When FSR acknowledged/unlocked the assignment
  assignedAt           DateTime? // When assignment was assigned (for time-to-unlock calculation)
  assignmentActivities AssignmentActivity[]
  attachments          AssignmentAttachment[]
  workParts            WorkPart[]
  vehicleTrips         VehicleTrip[] // Vehicle trips linked to this assignment
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  active               Boolean                @default(true)

  @@index([incidentId])
  @@index([assignedToId])
  @@index([statusId])
  @@index([active, assignedToId]) // Compound index for FSR filtering
  @@index([active, createdAt]) // Compound index for active assignments ordered by date
  @@index([unlockedAt]) // Optimize filtering by unlock status
}

model AssignmentActivity {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  description  String
  performedAt  DateTime   @default(now())
  workParts    WorkPart[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  active       Boolean    @default(true)

  @@index([assignmentId])
}

model AssignmentAttachment {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  filename     String
  filepath     String
  mimetype     String
  size         Int
  description  String?
  provider     String     @default("vercel-blob") // "vercel-blob" or "filesystem"
  uploadedAt   DateTime   @default(now())
  active       Boolean    @default(true)

  @@index([assignmentId])
}

model Part {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  price       Float
  stock       Int
  workParts   WorkPart[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  active      Boolean    @default(true)
}

model WorkPart {
  id           String              @id @default(cuid())
  partId       String
  part         Part                @relation(fields: [partId], references: [id])
  quantity     Int
  description  String?
  price        Float
  assignmentId String?
  assignment   Assignment?         @relation(fields: [assignmentId], references: [id])
  activityId   String?
  activity     AssignmentActivity? @relation(fields: [activityId], references: [id])
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  active       Boolean             @default(true)

  @@index([assignmentId])
  @@index([activityId])
}

model Line {
  id          Int                     @id @default(autoincrement())
  name        String
  description String?
  statusId    Int                     @default(1)
  status      LineStatus              @relation(fields: [statusId], references: [id])
  vicId       String
  vic         VehicleInspectionCenter @relation(fields: [vicId], references: [id])
  equipments  Equipment[]
  incidents   Incident[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  active      Boolean                 @default(true)

  @@unique([name, vicId])
  @@index([vicId])
  @@index([statusId])
}

model Equipment {
  id           Int             @id @default(autoincrement())
  name         String
  description  String?
  model        String?
  serialNumber String?
  statusId     Int             @default(1)
  status       EquipmentStatus @relation(fields: [statusId], references: [id])
  lineId       Int
  line         Line            @relation(fields: [lineId], references: [id])
  incidents    Incident[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  active       Boolean         @default(true)

  @@index([lineId])
  @@index([statusId])
  @@index([serialNumber])
}

model Vehicle {
  id            String        @id @default(cuid())
  make          String // e.g., "Toyota"
  model         String // e.g., "Corolla"
  year          Int // e.g., 2023
  licensePlate  String        @unique // e.g., "ABC-123-XYZ"
  vin           String?       @unique // Vehicle Identification Number (optional)
  color         String? // e.g., "White"
  statusId      Int           @default(1) // Status ID reference
  status        VehicleStatus @relation(fields: [statusId], references: [id])
  assignedFsrId String? // FSR currently assigned to this vehicle
  assignedFsr   User?         @relation("AssignedVehicles", fields: [assignedFsrId], references: [id])
  notes         String? // General notes about vehicle
  active        Boolean       @default(true) // Soft delete
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  trips         VehicleTrip[]

  @@index([licensePlate])
  @@index([statusId])
  @@index([assignedFsrId])
  @@index([active])
}

model VehicleTrip {
  id                 String            @id @default(cuid())
  vehicleId          String
  vehicle            Vehicle           @relation(fields: [vehicleId], references: [id])
  fsrId              String // FSR who drove
  fsr                User              @relation(fields: [fsrId], references: [id])
  assignmentId       String? // Optional assignment link
  assignment         Assignment?       @relation(fields: [assignmentId], references: [id])
  // Start data
  startOdometer      Int // Start reading in kilometers
  startPhotoUrl      String // Photo of start odometer
  startPhotoProvider String            @default("vercel-blob")
  startLatitude      Float? // GPS latitude
  startLongitude     Float? // GPS longitude
  startAddress       String? // Optional manual address
  startedAt          DateTime          @default(now())
  // End data (nullable until trip ends)
  endOdometer        Int? // End reading in kilometers
  endPhotoUrl        String? // Photo of end odometer
  endPhotoProvider   String?
  endLatitude        Float? // GPS latitude
  endLongitude       Float? // GPS longitude
  endAddress         String? // Optional manual address
  endedAt            DateTime?
  // Calculated
  kmDriven           Int? // Calculated: endOdometer - startOdometer
  // Metadata
  notes              String? // Trip notes
  statusId           Int               @default(1) // Status ID reference
  status             VehicleTripStatus @relation(fields: [statusId], references: [id])
  active             Boolean           @default(true) // Soft delete
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([vehicleId])
  @@index([fsrId])
  @@index([assignmentId])
  @@index([statusId])
  @@index([startedAt])
  @@index([active])
}

model Notification {
  id     String @id @default(cuid())
  userId String // Recipient user ID
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Notification content
  title   String // e.g., "Nueva Asignación"
  message String // e.g., "Se le ha asignado la asignación..."
  type    String // e.g., "assignment_assigned", "incident_updated"

  // Related entity (polymorphic approach)
  entityType String? // e.g., "assignment", "incident", "user"
  entityId   String? // ID of the related entity
  actionUrl  String? // URL to navigate when clicked

  // Status
  isRead Boolean   @default(false)
  readAt DateTime?

  // Metadata
  priority Int   @default(1) // 1=low, 2=medium, 3=high
  metadata Json? // Additional flexible data

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  active    Boolean  @default(true) // Soft delete

  @@index([userId, isRead]) // Fast unread count queries
  @@index([userId, createdAt]) // Fast "recent notifications" queries
  @@index([type]) // Filter by notification type
  @@index([active, createdAt]) // Cleanup queries
}
