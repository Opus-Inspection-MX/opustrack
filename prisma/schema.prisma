  stateId         Int
  state           State               @relation(fields: [stateId], references: [id])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  userAssignments UserClientAssignment[] // User assignments for this Client (sole membership source)
  scheduleClients    ScheduleClient[]
  incidents       Incident[]
  lines           Line[]
  active          Boolean             @default(true)
  // RF-550 attribution: null = system row (seed/migration), never backfilled.
