// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  password          String
  roleId            Int
  userStatusId      Int       @default(1)
  vicId             String?   // Deprecated - kept for backward compatibility
  vicIds            String[]  @default([]) // Array of VIC IDs for FSR assignments
  role              Role      @relation(fields: [roleId], references: [id])
  userStatus        UserStatus @relation(fields: [userStatusId], references: [id])
  userProfile       UserProfile?
  vic               VehicleInspectionCenter? @relation(fields: [vicId], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  workOrders        WorkOrder[]
  reportedIncidents Incident[] @relation("IncidentReporter")
  incidents         Incident[] @relation("IncidentUser") // relación opcional si usas userId en Incident
  vehicleTrips      VehicleTrip[] // Vehicle trips driven by this FSR
  active            Boolean   @default(true)
}

model Role {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  description    String?
  defaultPath    String
  users          User[]
  rolePermission RolePermission[]
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt
}

model Permission {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  resource    String? // e.g., "incidents", "users", "work-orders"
  action      String? // e.g., "read", "create", "update", "delete"
  routePath   String? // e.g., "/admin", "/incidents", "/fsr"
  roles       RolePermission[]
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt

  @@index([resource, action])
  @@index([routePath])
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  active       Boolean    @default(true)

  @@unique([roleId, permissionId])
}

model UserStatus {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  users  User[]
  active Boolean @default(true)
}

model UserProfile {
  id                 Int      @id @default(autoincrement())
  userId             String   @unique
  telephone          String?
  secondaryTelephone String?
  emergencyContact   String?
  jobPosition        String?
  user               User     @relation(fields: [userId], references: [id])
  updatedAt          DateTime @updatedAt
  active             Boolean  @default(true)
}

model VehicleInspectionCenter {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  address     String?
  rfc         String?
  companyName String?
  phone       String?
  contact     String?
  email       String?
  stateId     Int
  state       State      @relation(fields: [stateId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  users       User[]
  schedules   Schedule[]
  incidents   Incident[]
  Part        Part[] // (conservamos el nombre para no romper tu código)
  lines       Line[]
  active      Boolean    @default(true)
}

model State {
  id                       Int                       @id @default(autoincrement())
  name                     String                    @unique
  code                     String                    @unique
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  vehicleInspectionCenters VehicleInspectionCenter[]
  active                   Boolean                   @default(true)
}

model Schedule {
  id          String                  @id @default(cuid())
  title       String
  description String?
  scheduledAt DateTime                // Fecha de inicio
  endDate     DateTime?               // Fecha de fin (opcional)
  statusId    Int?                    // Estado del schedule
  status      IncidentStatus?         @relation(fields: [statusId], references: [id])
  vicId       String
  vic         VehicleInspectionCenter @relation(fields: [vicId], references: [id])
  incidents   Incident[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  active      Boolean                 @default(true)

  @@index([statusId])
  @@index([scheduledAt])
  @@index([endDate])
}

model IncidentType {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  incidents   Incident[]
  active      Boolean    @default(true)
}

model IncidentStatus {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  color      String      @default("#6B7280") // Hexadecimal color for status badge
  incidents  Incident[]
  workOrders WorkOrder[]
  schedules  Schedule[]  // Programaciones con este estado
  active     Boolean     @default(true)
}

model Incident {
  id           Int                      @id @default(autoincrement())
  title        String
  description  String
  priority     Int
  sla          Int
  typeId       Int?
  type         IncidentType?            @relation(fields: [typeId], references: [id])
  statusId     Int?
  status       IncidentStatus?          @relation(fields: [statusId], references: [id])
  reportedAt   DateTime                 @default(now())
  resolvedAt   DateTime?
  vicId        String?
  vic          VehicleInspectionCenter? @relation(fields: [vicId], references: [id])
  reportedById String?
  reportedBy   User?                    @relation("IncidentReporter", fields: [reportedById], references: [id])
  scheduleId   String?
  schedule     Schedule?                @relation(fields: [scheduleId], references: [id])
  lineId       Int?
  line         Line?                    @relation(fields: [lineId], references: [id])
  equipmentId  Int?
  equipment    Equipment?               @relation(fields: [equipmentId], references: [id])

  // userId estaba huérfano: definimos relación opcional clara
  userId String?
  user   User?   @relation("IncidentUser", fields: [userId], references: [id])

  workOrders WorkOrder[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  active     Boolean     @default(true)

  @@index([vicId])
  @@index([statusId])
  @@index([typeId])
  @@index([reportedById])
  @@index([lineId])
  @@index([equipmentId])
  @@index([reportedAt]) // Optimize date range queries in tracking
  @@index([active, reportedAt]) // Compound index for active incidents ordered by date
}

model WorkOrder {
  id             String                @id @default(cuid())
  incidentId     Int
  incident       Incident              @relation(fields: [incidentId], references: [id])
  assignedToId   String
  assignedTo     User                  @relation(fields: [assignedToId], references: [id])
  statusId       Int?
  status         IncidentStatus?       @relation(fields: [statusId], references: [id])
  notes          String?
  folio          String?                // Folio number (Numero de folio)
  startedAt      DateTime?
  finishedAt     DateTime?
  workActivities WorkActivity[]
  attachments    WorkOrderAttachment[]
  workParts      WorkPart[]
  vehicleTrips   VehicleTrip[] // Vehicle trips linked to this work order
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  active         Boolean               @default(true)

  @@index([incidentId])
  @@index([assignedToId])
  @@index([statusId])
  @@index([folio]) // Optimize folio search queries
  @@index([active, assignedToId]) // Compound index for FSR filtering
  @@index([active, createdAt]) // Compound index for active work orders ordered by date
}

model WorkActivity {
  id          String     @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder  @relation(fields: [workOrderId], references: [id])
  description String
  performedAt DateTime   @default(now())
  workParts   WorkPart[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  active      Boolean    @default(true)

  @@index([workOrderId])
}

model WorkOrderAttachment {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  filename    String
  filepath    String
  mimetype    String
  size        Int
  description String?
  provider    String    @default("vercel-blob") // "vercel-blob" or "filesystem"
  uploadedAt  DateTime  @default(now())
  active      Boolean   @default(true)

  @@index([workOrderId])
}

model Part {
  id          String                  @id @default(cuid())
  vicId       String
  vic         VehicleInspectionCenter @relation(fields: [vicId], references: [id])
  name        String
  description String?
  price       Float
  stock       Int
  workParts   WorkPart[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  active      Boolean                 @default(true)

  @@unique([name, vicId]) // ← para upsert por nombre+VIC
  @@index([vicId])
}

model WorkPart {
  id             String        @id @default(cuid())
  partId         String
  part           Part          @relation(fields: [partId], references: [id])
  quantity       Int
  description    String?
  price          Float
  workOrderId    String?
  workOrder      WorkOrder?    @relation(fields: [workOrderId], references: [id])
  workActivityId String?
  workActivity   WorkActivity? @relation(fields: [workActivityId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  active         Boolean       @default(true)

  @@index([workOrderId])
  @@index([workActivityId])
}

model Line {
  id          Int                     @id @default(autoincrement())
  name        String
  description String?
  vicId       String
  vic         VehicleInspectionCenter @relation(fields: [vicId], references: [id])
  equipments  Equipment[]
  incidents   Incident[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  active      Boolean                 @default(true)

  @@index([vicId])
}

model Equipment {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  lineId      Int
  line        Line       @relation(fields: [lineId], references: [id])
  incidents   Incident[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  active      Boolean    @default(true)

  @@index([lineId])
}

model Vehicle {
  id           String        @id @default(cuid())
  make         String        // e.g., "Toyota"
  model        String        // e.g., "Corolla"
  year         Int           // e.g., 2023
  licensePlate String        @unique // e.g., "ABC-123-XYZ"
  vin          String?       @unique // Vehicle Identification Number (optional)
  color        String?       // e.g., "White"
  status       String        @default("AVAILABLE") // AVAILABLE, IN_USE, MAINTENANCE, INACTIVE
  notes        String?       // General notes about vehicle
  active       Boolean       @default(true) // Soft delete
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  trips        VehicleTrip[]

  @@index([licensePlate])
  @@index([status])
  @@index([active])
}

model VehicleTrip {
  id                 String     @id @default(cuid())
  vehicleId          String
  vehicle            Vehicle    @relation(fields: [vehicleId], references: [id])
  fsrId              String // FSR who drove
  fsr                User       @relation(fields: [fsrId], references: [id])
  workOrderId        String? // Optional work order link
  workOrder          WorkOrder? @relation(fields: [workOrderId], references: [id])
  // Start data
  startOdometer      Int // Start reading in kilometers
  startPhotoUrl      String // Photo of start odometer
  startPhotoProvider String     @default("vercel-blob")
  startLatitude      Float? // GPS latitude
  startLongitude     Float? // GPS longitude
  startAddress       String? // Optional manual address
  startedAt          DateTime   @default(now())
  // End data (nullable until trip ends)
  endOdometer        Int? // End reading in kilometers
  endPhotoUrl        String? // Photo of end odometer
  endPhotoProvider   String?
  endLatitude        Float? // GPS latitude
  endLongitude       Float? // GPS longitude
  endAddress         String? // Optional manual address
  endedAt            DateTime?
  // Calculated
  kmDriven           Int? // Calculated: endOdometer - startOdometer
  // Metadata
  notes              String? // Trip notes
  status             String     @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, CANCELLED
  active             Boolean    @default(true) // Soft delete
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([vehicleId])
  @@index([fsrId])
  @@index([workOrderId])
  @@index([status])
  @@index([startedAt])
  @@index([active])
}
