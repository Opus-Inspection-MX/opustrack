model Incident {
  id           Int                      @id @default(autoincrement())
  title        String
  description  String
  typeId       Int
  type         IncidentType             @relation(fields: [typeId], references: [id])
  statusId     Int?
  status       IncidentStatus?          @relation(fields: [statusId], references: [id])
  reportedAt   DateTime                 @default(now())
  startedAt    DateTime?
  resolvedAt   DateTime?
  cancelledAt  DateTime?
  cancellationReason String?
  clientId        String?
  client          Client? @relation(fields: [clientId], references: [id])
  reportedById String?
  reportedBy   User?                    @relation("IncidentReporter", fields: [reportedById], references: [id])
  /// Free text: the actual person who raised it.
  ///
  /// A center's account is shared by everyone who works there, so `reportedBy`
  /// identifies the center, not a human. This is deliberately NOT a User
  /// relation — the people typing it have no accounts of their own.
  reporterName String?
  scheduleId   String?
  schedule     Schedule?                @relation(fields: [scheduleId], references: [id])
  lineId       Int?
  line         Line?                    @relation(fields: [lineId], references: [id])
  equipmentId  Int?
  equipment    Equipment?               @relation(fields: [equipmentId], references: [id])

  assignments Assignment[]
  assignees   IncidentAssignee[] // RF-025: FSRs habilitados para este incidente
  events      IncidentEvent[] // RF-219: append-only audit trail
  attachments IncidentAttachment[] // RF-217: evidence photos filed with the report
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  active      Boolean            @default(true)
  // RF-550 attribution: null = system row (seed/migration), never backfilled.
  createdById     String?
  updatedById     String?
  deactivatedAt   DateTime?
  deactivatedById String?

  @@index([clientId])
  @@index([statusId])
  @@index([typeId])
  @@index([reportedById])
  @@index([lineId])
  @@index([equipmentId])
  @@index([reportedAt]) // Optimize date range queries in tracking
  @@index([active, reportedAt]) // Compound index for active incidents ordered by date
}

model IncidentAssignee {
  id         String   @id @default(cuid())
  incidentId Int
  userId     String
  assignedAt DateTime @default(now())
  active       Boolean  @default(true)
  // RF-550 attribution: null = system row (seed/migration), never backfilled.
  createdById     String?
  updatedById     String?
  deactivatedAt   DateTime?
  deactivatedById String?

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([incidentId, userId])
  @@index([userId])
  @@index([incidentId])
  @@index([active, userId])
  @@map("incident_assignees")
}

/// Append-only audit trail for incidents (RF-219).
///
/// One row per status-affecting occurrence: creation, status transitions,
/// assignee changes, cancellations, reopens, bulk imports, skipped
/// recalculations, and (reserved) admin overrides. Application code MUST
/// never update or delete these rows — the log is observability, not
/// authority. State machines remain the sole writers of `statusId`.
model IncidentEvent {
  id         String            @id @default(cuid())
  incidentId Int
  incident   Incident          @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  eventType  IncidentEventType
  /// Human actor; null means the transition was system-driven (sync).
  actorId    String?
  fromStatus String?
  toStatus   String?
  /// Small snapshot: resolvedAt/priorResolvedAt timestamps, reasons, row refs.
  /// Allowlisted per event type in `logIncidentEvent`; never queried by field.
  payload    Json?
  createdAt  DateTime          @default(now())

  @@index([incidentId, createdAt])
}

/// Closed vocabulary for the audit log. Adding a type is a migration — the
/// right friction for audit semantics. `ASSIGN_DENIED` (gate) and
/// `ASSIGNEE_AUTO_CREATED` (log) cover both §3.5(a) outcomes; the unused one
/// simply never fires. `ADMIN_OVERRIDE` is reserved for the §1.3 override.
enum IncidentEventType {
  CREATED
  STATUS_CHANGED
  ASSIGNEE_ADDED
  ASSIGNEE_REMOVED
  ASSIGNEE_AUTO_CREATED
  ASSIGN_DENIED
  CANCELLED
  REOPENED
  BULK_IMPORTED
  RECALC_SKIPPED
  ADMIN_OVERRIDE
}

/// Attributable-management audit log (RF-550–554), sibling of the RF-219
/// IncidentEvent trail. IncidentEvent owns status-affecting occurrences;
/// AuditLog owns who changed which manageable row. Append-only: application
/// code MUST never update or delete these rows (enforced by unit test, no DB
/// triggers). No soft delete, no backfill — rows begin at deploy.
model AuditLog {
  id        String      @id @default(cuid())
  /// Human actor; null = system write (seed, migration, unauthenticated job).
  actorId   String?
  entity    AuditEntity
  entityId  String
  action    AuditAction
  /// Allowlisted, PII-free change snapshot written by `logAudit`.
  payload   Json?
  createdAt DateTime    @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

/// Closed vocabulary of auditable domain entities. Extending it is a
/// migration + spec amendment on purpose (spec 11, RF-552).
enum AuditEntity {
  CLIENT
  INCIDENT
  ASSIGNMENT
  LINE
  EQUIPMENT
  VEHICLE
  VEHICLE_TRIP
  SCHEDULE
  NOTIFICATION_CHANNEL
}

/// Closed action vocabulary. Status transitions are NOT here — they belong
/// to IncidentEvent (RF-553 no-double-write).
enum AuditAction {
  CREATE
  UPDATE
  DEACTIVATE
  ASSIGN
  UNASSIGN
}

model Assignment {
  id                   String                 @id @default(cuid())
  incidentId           Int
  incident             Incident               @relation(fields: [incidentId], references: [id])
  assignees            AssignmentAssignee[] // Multiple FSRs per assignment (M-N)
  statusId             Int?
  status               AssignmentStatus?      @relation(fields: [statusId], references: [id])
  notes                String?
  folio                Int                    @unique @default(autoincrement()) // Auto-generated numeric folio
  odtFolio             String? // ODT folio captured from external system (RF-010)
  startedAt            DateTime?
  finishedAt           DateTime?
  // Renamed from unlockedAt — "Visto" state machine: when FSR first acknowledged.
  seenAt               DateTime?
  seenById             String?
  seenBy               User?                  @relation("AssignmentSeenBy", fields: [seenById], references: [id])
  assignedAt           DateTime? // When assignment was assigned (for time-to-seen calculation)
  // GPS captured when transitioning to INICIADO (start of on-site work)
  startLatitude        Float?
  startLongitude       Float?
  startAddress         String?
  // GPS captured when transitioning to CERRADO (end of on-site work)
  endLatitude          Float?
  endLongitude         Float?
  endAddress           String?
  assignmentActivities AssignmentActivity[]
  items                AssignmentItem[]
  attachments          AssignmentAttachment[]
  vehicleTrips         VehicleTrip[] // Vehicle trips linked to this assignment
  scheduledDate        DateTime? // Optional scheduled date for FSR availability check (RF-708)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  active               Boolean                @default(true)
  // RF-550 attribution: null = system row (seed/migration), never backfilled.
  createdById     String?
  updatedById     String?
  deactivatedAt   DateTime?
  deactivatedById String?

  @@index([incidentId])
  @@index([statusId])
  @@index([active, createdAt]) // Compound index for active assignments ordered by date
  @@index([seenAt]) // Optimize filtering by seen status
  @@index([seenById])
  @@index([scheduledDate])
}

model AssignmentAssignee {
  id           String   @id @default(cuid())
  assignmentId String
  userId       String
  assignedAt   DateTime @default(now())
  active       Boolean  @default(true)
  // RF-550 attribution: null = system row (seed/migration), never backfilled.
  createdById     String?
  updatedById     String?
  deactivatedAt   DateTime?
  deactivatedById String?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])

  @@unique([assignmentId, userId])
  @@index([userId])
  @@index([assignmentId])
  @@index([active, userId])
  @@map("assignment_assignees")
}

model AssignmentActivity {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  description  String
  performedAt  DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  active       Boolean    @default(true)
  // RF-550 attribution: null = system row (seed/migration), never backfilled.
  createdById     String?
  updatedById     String?
  deactivatedAt   DateTime?
  deactivatedById String?

  @@index([assignmentId])
}

model AssignmentAttachment {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  filename     String
  filepath     String
  mimetype     String
  size         Int
  description  String?
  provider     String     @default("vercel-blob") // "vercel-blob" or "filesystem"
  uploadedAt   DateTime   @default(now())
  active       Boolean    @default(true)
  // RF-550 attribution: null = system row (seed/migration), never backfilled.
  createdById     String?
  updatedById     String?
  deactivatedAt   DateTime?
  deactivatedById String?

  @@index([assignmentId])
}

/// Evidence filed with the incident report itself (RF-217).
///
/// Field-for-field clone of `AssignmentAttachment` by design, not an
/// abstraction: the two lifecycles (incident vs assignment) evolve
/// independently, and sharing a table would couple them and force an RF-259
/// migration. Unlike assignment attachments, these are NEVER required —
/// reporting must never be blocked for lack of photos.
model IncidentAttachment {
  id          String   @id @default(cuid())
  incidentId  Int
  incident    Incident @relation(fields: [incidentId], references: [id])
  filename    String
  filepath    String
  mimetype    String
  size        Int
  description String?
  provider    String   @default("vercel-blob") // "vercel-blob" or "filesystem"
  uploadedAt  DateTime @default(now())
  active      Boolean  @default(true)
  // RF-550 attribution: null = system row (seed/migration), never backfilled.
  createdById     String?
  updatedById     String?
  deactivatedAt   DateTime?
  deactivatedById String?

  @@index([incidentId])
}



model Line {
  id          Int                     @id @default(autoincrement())
  name        String
  description String?
  clientId       String
  client         Client @relation(fields: [clientId], references: [id])
  equipments  Equipment[]
  incidents   Incident[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  active      Boolean                 @default(true)
  // RF-550 attribution: null = system row (seed/migration), never backfilled.
  createdById     String?
  updatedById     String?
  deactivatedAt   DateTime?
  deactivatedById String?

  @@unique([name, clientId])
  @@index([clientId])
