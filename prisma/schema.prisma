model Equipment {
  id           Int             @id @default(autoincrement())
  name         String
  description  String?
  model        String?
  serialNumber String?
  statusId     Int             @default(1)
  status       EquipmentStatus @relation(fields: [statusId], references: [id])
  lineId       Int
  line         Line            @relation(fields: [lineId], references: [id])
  incidents    Incident[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  active       Boolean         @default(true)
  // RF-550 attribution: null = system row (seed/migration), never backfilled.
  createdById     String?
  updatedById     String?
  deactivatedAt   DateTime?
  deactivatedById String?

  @@index([lineId])
  @@index([statusId])
  @@index([serialNumber])
}

model Vehicle {
  id            String        @id @default(cuid())
  make          String // e.g., "Toyota"
  model         String // e.g., "Corolla"
  year          Int // e.g., 2023
  licensePlate  String        @unique // e.g., "ABC-123-XYZ"
  vin           String?       @unique // Vehicle Identification Number (optional)
  color         String? // e.g., "White"
  statusId      Int           @default(1) // Status ID reference
  status        VehicleStatus @relation(fields: [statusId], references: [id])
  assignedFsrId String? // FSR currently assigned to this vehicle
  assignedFsr   User?         @relation("AssignedVehicles", fields: [assignedFsrId], references: [id])
  notes         String? // General notes about vehicle
  active        Boolean       @default(true) // Soft delete
  // RF-550 attribution: null = system row (seed/migration), never backfilled.
  createdById     String?
  updatedById     String?
  deactivatedAt   DateTime?
  deactivatedById String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  trips         VehicleTrip[]

  @@index([licensePlate])
  @@index([statusId])
  @@index([assignedFsrId])
  @@index([active])
}

model VehicleTrip {
  id                 String            @id @default(cuid())
  vehicleId          String
  vehicle            Vehicle           @relation(fields: [vehicleId], references: [id])
  fsrId              String // FSR who drove
  fsr                User              @relation(fields: [fsrId], references: [id])
  assignmentId       String? // Optional assignment link
  assignment         Assignment?       @relation(fields: [assignmentId], references: [id])
  // Start data
  startOdometer      Int // Start reading in kilometers
  startPhotoUrl      String // Photo of start odometer
  startPhotoProvider String            @default("vercel-blob")
  startLatitude      Float? // GPS latitude
  startLongitude     Float? // GPS longitude
  startAddress       String? // Optional manual address
  startedAt          DateTime          @default(now())
  // End data (nullable until trip ends)
  endOdometer        Int? // End reading in kilometers
  endPhotoUrl        String? // Photo of end odometer
  endPhotoProvider   String?
  endLatitude        Float? // GPS latitude
  endLongitude       Float? // GPS longitude
  endAddress         String? // Optional manual address
  endedAt            DateTime?
  // Calculated
  kmDriven           Int? // Calculated: endOdometer - startOdometer
  // Metadata
  notes              String? // Trip notes
  statusId           Int               @default(1) // Status ID reference
  status             VehicleTripStatus @relation(fields: [statusId], references: [id])
  active             Boolean           @default(true) // Soft delete
  // RF-550 attribution: null = system row (seed/migration), never backfilled.
  createdById     String?
  updatedById     String?
  deactivatedAt   DateTime?
  deactivatedById String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([vehicleId])
  @@index([fsrId])
  @@index([assignmentId])
  @@index([statusId])
  @@index([startedAt])
  @@index([active])
}

model Notification {
  id     String @id @default(cuid())
  userId String // Recipient user ID
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Notification content
  title   String // e.g., "Nueva Asignación"
  message String // e.g., "Se le ha asignado la asignación..."
  type    String // e.g., "assignment_assigned", "incident_updated"

  // Related entity (polymorphic approach)
  entityType String? // e.g., "assignment", "incident", "user"
  entityId   String? // ID of the related entity
  actionUrl  String? // URL to navigate when clicked

  // Status
  isRead Boolean   @default(false)
  readAt DateTime?

  // Metadata
  priority Int   @default(1) // 1=low, 2=medium, 3=high
  metadata Json? // Additional flexible data

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  active    Boolean  @default(true) // Soft delete

  @@index([userId, isRead]) // Fast unread count queries
  @@index([userId, createdAt]) // Fast "recent notifications" queries
  @@index([type]) // Filter by notification type
  @@index([active, createdAt]) // Cleanup queries
}

/// Per-event delivery switches (Phase 2 channel matrix).
///
/// One row per notification type, keyed by the type string itself — a new
/// event needs no migration, only a catalog entry plus a seed row. When both
/// switches are off the event is disabled. No `active` column on purpose:
/// rows are keyed configuration, never deleted (log-shaped like AuditLog,
/// unlike the soft-deleted domain models the attribution matrix test pins).
model NotificationChannelPolicy {
  type      String  @id
  inApp     Boolean @default(true)
  email     Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // RF-550 attribution: null = system row (seed/migration), never backfilled.
  createdById     String?
  updatedById     String?
  deactivatedAt   DateTime?
  deactivatedById String?

  @@map("notification_channel_policies")
}

/// One row per outbound message: visibility plus retries (Phase 2).
///
/// Log-shaped (no `active`, like AuditLog): a retry UPDATES the row's
/// status/attempts, nothing ever soft-deletes it. `lastError` carries the
/// failure kind only — never addresses or bodies (PII-free by construction).
model EmailOutbox {
  id               String           @id @default(cuid())
  notificationType String
  subject          String
  text             String
  html             String
  recipients       String[]
  status           EmailOutboxStatus @default(PENDIENTE)
  attempts         Int              @default(0)
  lastError        String?
  nextAttemptAt    DateTime?
  broadcastId      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, nextAttemptAt])
  @@map("email_outbox")
}

enum EmailOutboxStatus {
  PENDIENTE
  ENVIADO
  FALLIDO
}

// ─── Holidays & Vacations (RF-700–RF-749) ────────────────────────────────────

/// Official non-working day rule (LFT Art. 74).
/// A rule is either a fixed date (month+day), an n-th Monday (month+nthMonday),
/// or a one-time sexennial event (isRecurring:false + year).
/// XOR(day, nthMonday) — exactly one must be set.
model Holiday {
  id          Int     @id @default(autoincrement())
  name        String
  /// Calendar month (1=Jan … 12=Dec). Always required.
  month       Int
  /// Day-of-month for fixed-date holidays. Null for n-th-Monday rules.
  day         Int?
  /// Which Monday of the month (1=first, 3=third). Null for fixed-date rules.
  nthMonday   Int?
  /// True for annually recurring holidays. False for one-time events (requires year).
  isRecurring Boolean @default(true)
  /// The specific year for one-time (sexennial) events. Null for recurring rules.
  year        Int?
  active      Boolean @default(true)
  // RF-550 attribution: null = system row (seed/migration), never backfilled.
  createdById     String?
  updatedById     String?
  deactivatedAt   DateTime?
  deactivatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([month])
  @@map("holidays")
}

/// Status catalog for vacation requests — follows ScheduleStatus pattern.
/// Seed values: PENDIENTE, APROBADA, RECHAZADA.
model VacationStatus {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  color       String    @default("#6B7280")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  vacations   Vacation[]
  active      Boolean   @default(true)
  // RF-550 attribution: null = system row (seed/migration), never backfilled.
  createdById     String?
  updatedById     String?
  deactivatedAt   DateTime?
  deactivatedById String?

  @@map("vacation_statuses")
}

/// FSR absence / vacation period request (RF-701, RF-702).
/// Date range is inclusive; stored as UTC instants representing CDMX start/end of day.
model Vacation {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation("VacationUser", fields: [userId], references: [id])
  startDate    DateTime
  endDate      DateTime
  reason       String?
  statusId     Int
  status       VacationStatus @relation(fields: [statusId], references: [id])
  approvedById String?
  approvedBy   User?          @relation("VacationApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  // Nullable because rows created before the balance system have no period to
  // backfill from (there was no hireDate to derive one). Every new request
  // resolves one; see resolveVacationPeriod.
  periodId         String?
  period           VacationPeriod? @relation(fields: [periodId], references: [id])
  // Business days this request consumes, snapshotted at creation. Snapshotting
  // keeps history stable if the Holiday catalog is edited afterwards.
  businessDaysUsed Int?
  active       Boolean        @default(true)
  // RF-550 attribution: null = system row (seed/migration), never backfilled.
  createdById     String?
  updatedById     String?
  deactivatedAt   DateTime?
  deactivatedById String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([userId])
  @@index([statusId])
  @@index([userId, startDate, endDate])
  @@index([active, userId])
  @@index([periodId])
  @@map("vacations")
}

/// Days-of-entitlement table by years of service (LFT Art. 76, 2023 reform).
/// A catalog rather than hardcoded constants so the rules can be corrected from
/// the admin UI if the law changes. Resolution: the row where
/// minYears <= yearsOfService <= (maxYears ?? infinity).
model VacationAccrualRule {
  id        Int      @id @default(autoincrement())
  minYears  Int      @unique // inclusive lower bound, in completed years of service
  maxYears  Int? // inclusive upper bound; null = open-ended final tier
  days      Int
  active    Boolean  @default(true)
  // RF-550 attribution: null = system row (seed/migration), never backfilled.
  createdById     String?
  updatedById     String?
  deactivatedAt   DateTime?
  deactivatedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@map("vacation_accrual_rules")
}

/// Singleton configuration row (id is pinned to 1). `graceWindowMonths` is how
/// long days stay usable AFTER their accrual year closes (LFT Art. 81 grace
/// window); the law says 6, the business default here is 12.
model VacationSetting {
  id                Int      @id @default(1)
  graceWindowMonths Int      @default(12)
  updatedAt         DateTime @updatedAt

  @@map("vacation_settings")
}

/// One anniversary year of service per user.
///
/// `accrualStart`/`accrualEnd`/`graceEnd`/`ruleDays` are SNAPSHOTS taken when
/// the row is created: editing the accrual table or the grace-window setting
/// must never retroactively resize a period someone already has approved
/// vacations inside.
///
/// There is deliberately no `remainingDays` column — the balance is always
/// derived (see getPeriodBalance), so raising `overrideDays` can only ever
/// increase what is available and can never orphan an existing request.
model VacationPeriod {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation("VacationPeriodUser", fields: [userId], references: [id], onDelete: Cascade)
  periodNumber Int // 1-based; equals the year of service used for rule lookup
  accrualStart DateTime // hireDate + (periodNumber - 1) years, CDMX start of day
  accrualEnd   DateTime // accrualStart + 1 year - 1 day, CDMX end of day
  graceEnd     DateTime // accrualEnd + graceWindowMonths as it stood at creation
  ruleDays     Int // snapshot of the matching VacationAccrualRule.days
  overrideDays Int? // admin correction; replaces ruleDays when present
  vacations    Vacation[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([userId, periodNumber])
  @@index([userId])
  @@index([accrualStart, graceEnd])
  @@map("vacation_periods")
}

/// Dedupe record for offline draft-and-retry (RF-260, RF-261).
/// One row per flushed idempotency key: a retried draft with a known key
/// converges on the live target instead of re-executing the transition.
/// Rows are observability, never authority — guards always re-run.
model ActionIdempotency {
  key       String   @id
  action    String
  targetId  String?
  createdAt DateTime @default(now())

  @@map("action_idempotency")
}

/// Refacciones o equipo usados en una asignación, como lista abierta.
///
/// Deliberately NOT a foreign key into a parts catalogue. The previous design
/// pointed at a `Part` table carrying stock, and maintaining that means running
/// a warehouse — receiving, counting, reconciling — which is not what this
/// system does. The technician writes down what was used and what it cost.
model AssignmentItem {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  /// Free text: "Sensor de proximidad", "Manguera 1/2 pulgada".
  name         String
  quantity     Int
  /// Price per unit. The line total is derived, never stored.
  unitPrice    Float
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  active       Boolean    @default(true)
  // RF-550 attribution: null = system row (seed/migration), never backfilled.
  createdById     String?
  updatedById     String?
  deactivatedAt   DateTime?
  deactivatedById String?

  @@index([assignmentId])
}
