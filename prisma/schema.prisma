// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Disposable scratch database for `prisma migrate diff` drift checks
  // (`npm run db:drift`). Prisma creates it automatically; it never holds
  // real data. See SHADOW_DATABASE_URL in .env.example / config/e2e.env.
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id                  String                   @id @default(cuid())
  name                String
  email               String                   @unique
  password            String
  userStatusId        Int                      @default(1)
  sessionVersion      Int                      @default(1) // Increment to invalidate all user sessions
  // A user holds MANY roles: someone can administer vacations, administer
  // operations, and still be an FSR who gets dispatched. There is deliberately
  // no `roleId` scalar beside this. Client membership likewise lives ONLY in
  // the `clientAssignments` junction table: the deprecated `clienteId` /
  // `clienteIds` columns were removed (2.7) after every read path moved to
  // the junction. One source of truth.
  userRoles           UserRole[]
  userStatus          UserStatus               @relation(fields: [userStatusId], references: [id])
  userProfile         UserProfile?
  clientAssignments      UserClientAssignment[] // Client assignments for this user
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  assignmentAssignees AssignmentAssignee[] // Assignments this user is assigned to (M-N)
  incidentAssignees   IncidentAssignee[] // Incidents this user is enabled to work on (RF-025)
  assignmentsSeen     Assignment[]             @relation("AssignmentSeenBy") // Assignments first acknowledged ("visto") by this user
  reportedIncidents   Incident[]               @relation("IncidentReporter")
  vehicleTrips        VehicleTrip[] // Vehicle trips driven by this FSR
  assignedVehicles    Vehicle[]                @relation("AssignedVehicles") // Vehicles assigned to this FSR
  notifications       Notification[] // User's notifications
  vacations           Vacation[]               @relation("VacationUser") // Vacation requests owned by this user (RF-701)
  approvedVacations   Vacation[]               @relation("VacationApprover") // Vacations approved/rejected by this user (RF-702)
  // Nullable: users created before vacation balances existed have no hire date.
  // Balance features stay blocked (with a clear message) until an admin sets it.
  hireDate            DateTime?
  vacationPeriods     VacationPeriod[]         @relation("VacationPeriodUser")
  active              Boolean                  @default(true)
  // RF-550 attribution: null = system row (seed/migration), never backfilled.
  createdById     String?
  updatedById     String?
  deactivatedAt   DateTime?
  deactivatedById String?
}

model UserClientAssignment {
  id        String   @id @default(cuid())
  userId    String
  clientId     String
  isPrimary Boolean  @default(false) // Primary Client for the user
  active    Boolean  @default(true)
  // RF-550 attribution: null = system row (seed/migration), never backfilled.
  createdById     String?
  updatedById     String?
  deactivatedAt   DateTime?
  deactivatedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  client  Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId])
  @@index([clientId])
}

/// Roles a user holds. A user with several roles gets the UNION of their
/// permissions, and lands on the `defaultPath` of the highest-priority one.
model UserRole {
  id        Int      @id @default(autoincrement())
  userId    String
  roleId    Int
  active    Boolean  @default(true)
  // RF-550 attribution: null = system row (seed/migration), never backfilled.
  createdById     String?
  updatedById     String?
  deactivatedAt   DateTime?
  deactivatedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([userId, active])
  @@index([roleId])
  @@map("user_roles")
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  defaultPath String
  /// Bypasses every route and permission check. ROOT only.
  ///
  /// This replaced the hardcoded `role.name === "ADMINISTRADOR"` check. The old
  /// name meant four different things at once — bypass, cross-Client data
  /// scope, ownership override, and notification audience — and only the first
  /// one belongs to a superuser. The other three are permissions now, so an
  /// operations admin can see every Client without being able to grant roles.
  isSuperuser Boolean @default(false)
  /// Higher wins when a multi-role user needs one landing page.
  priority    Int     @default(0)

  userRoles      UserRole[]
  rolePermission RolePermission[]
  /// Rows where this role is the SENDER: which roles it may broadcast to.
  broadcastGrants RoleBroadcastTarget[] @relation("BroadcastSource")
  /// Rows where this role is a TARGET: which roles may broadcast to it.
  broadcastReach RoleBroadcastTarget[] @relation("BroadcastTarget")
  active         Boolean          @default(true)
  // RF-550 attribution: null = system row (seed/migration), never backfilled.
  createdById     String?
  updatedById     String?
  deactivatedAt   DateTime?
  deactivatedById String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt
}

model Permission {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  resource    String? // e.g., "incidents", "users", "assignments"
  action      String? // e.g., "read", "create", "update", "delete"
  routePath   String? // e.g., "/admin", "/incidents", "/fsr"
  /// Match `routePath` by equality instead of by prefix.
  ///
  /// Route coverage is prefix-based, so granting `/admin` grants the whole
  /// panel. A module admin needs the `/admin` landing page WITHOUT inheriting
  /// `/admin/incidents`, and that is the only way to express it.
  exact       Boolean          @default(false)
  roles       RolePermission[]
  active      Boolean          @default(true)
  // RF-550 attribution: null = system row (seed/migration), never backfilled.
  createdById     String?
  updatedById     String?
  deactivatedAt   DateTime?
  deactivatedById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt

  @@index([resource, action])
  @@index([routePath])
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  active       Boolean    @default(true)
  // RF-550 attribution: null = system row (seed/migration), never backfilled.
  createdById     String?
  updatedById     String?
  deactivatedAt   DateTime?
  deactivatedById String?

  @@unique([roleId, permissionId])
}

/// Which roles each role may broadcast notifications to (Phase 1 RBAC).
///
/// A sender role with no rows can broadcast to nobody (fail closed); ROOT
/// (`isSuperuser`) bypasses the table and reaches every role. Edited from
/// `/admin/roles/[id]` (Phase 4); seeded for the module admins here.
model RoleBroadcastTarget {
  id           Int     @id @default(autoincrement())
  sourceRoleId Int
  targetRoleId Int
  sourceRole   Role    @relation("BroadcastSource", fields: [sourceRoleId], references: [id])
  targetRole   Role    @relation("BroadcastTarget", fields: [targetRoleId], references: [id])
  active       Boolean @default(true)
  // RF-550 attribution: null = system row (seed/migration), never backfilled.
  createdById     String?
  updatedById     String?
  deactivatedAt   DateTime?
  deactivatedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([sourceRoleId, targetRoleId])
  @@index([sourceRoleId])
  @@index([targetRoleId])
  @@map("role_broadcast_targets")
}

model UserStatus {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  users  User[]
  active Boolean @default(true)
  // RF-550 attribution: null = system row (seed/migration), never backfilled.
