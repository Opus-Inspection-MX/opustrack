  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  active      Boolean         @default(true)
  // RF-550 attribution: null = system row (seed/migration), never backfilled.
  createdById     String?
  updatedById     String?
  deactivatedAt   DateTime?
  deactivatedById String?

  @@index([statusId])
  @@index([scheduledAt])
  @@index([endDate])
