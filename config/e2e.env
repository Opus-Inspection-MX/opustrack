# ============================================================================
# End-to-end test environment. TRACKED IN GIT ON PURPOSE.
#
# Every value here is disposable and points at the throwaway container defined
# in docker-compose.e2e.yml. NEVER put a real credential, real database or real
# secret in this file — it is committed.
#
# To run against your own accounts or your own database, create
# `config/e2e.local.env` (gitignored). It is loaded after this file and
# overrides it:
#
#   E2E_ADMIN_EMAIL=...
#   E2E_PASSWORD=...
#
# ============================================================================

# --- Throwaway database (docker-compose.e2e.yml) ---------------------------
E2E_DB_PORT=5433
DATABASE_URL="postgresql://opustrack_e2e:opustrack_e2e@localhost:5433/opustrack_e2e?schema=public"

# --- App under test --------------------------------------------------------
# Its own port, so the suite never attaches to a dev server or a container
# already holding 3000.
PLAYWRIGHT_PORT=3100
NEXTAUTH_URL="http://localhost:3100"
NEXTAUTH_SECRET="e2e-only-secret-not-used-anywhere-else-Kf3xQ2pR"
# Keeps the [next-auth][warn][DEBUG_ENABLED] banner out of the test log.
NEXTAUTH_DEBUG="false"
FILE_STORAGE_PROVIDER="filesystem"

# --- Seed ------------------------------------------------------------------
# Which seed populates the ephemeral container. The default is the tracked
# template: self-contained mock data, no secrets, all four roles.
# Point it at initial_load/seed.ts from config/e2e.local.env to load the real
# personnel INSIDE the throwaway container — the database stays ephemeral.
E2E_SEED_SCRIPT="initial_load/seed.example.ts"

# --- Accounts --------------------------------------------------------------
# Created by the tracked template seed (initial_load/seed.example.ts), which is
# self-contained mock data — these are nobody's real credentials.
# If an account is missing, e2e/db.setup.ts provisions it.
E2E_PASSWORD="password123"
E2E_ADMIN_EMAIL="admin@opusinspection.com"
E2E_FSR_EMAIL="fsr@opusinspection.com"
E2E_CLIENT_EMAIL="client@opusinspection.com"
E2E_GUEST_EMAIL="guest@opusinspection.com"
