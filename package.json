{
  "name": "opustrack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "dotenv -e .env.development -- next dev --turbopack",
    "build": "prisma generate && next build --turbopack",
    "build:local": "dotenv -e .env.production -p NODE_ENV=production -- next build --turbopack",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "db:migrate": "dotenv -e .env.development -- prisma migrate dev",
    "db:studio": "dotenv -e .env.development -- prisma studio",
    "db:reset": "dotenv -e .env.development -- prisma migrate reset --schema=prisma/schema.prisma",
    "db:seed": "dotenv -e .env.development -- prisma db seed",
    "test": "dotenv -e .env.development -- vitest",
    "test:ui": "dotenv -e .env.development -- vitest --ui",
    "test:coverage": "dotenv -e .env.development -- vitest run --coverage",
    "test:watch": "dotenv -e .env.development -- vitest --watch",
    "test:e2e": "npm run e2e:setup && npm run build:e2e && dotenv -e config/e2e.env -e config/e2e.local.env -o -- playwright test",
    "test:e2e:ui": "npm run e2e:setup && dotenv -e config/e2e.env -e config/e2e.local.env -o -v E2E_SERVER=dev -- playwright test --ui",
    "test:e2e:debug": "npm run e2e:setup && dotenv -e config/e2e.env -e config/e2e.local.env -o -v E2E_SERVER=dev -- playwright test --debug",
    "dev:e2e": "dotenv -e config/e2e.env -e config/e2e.local.env -o -- next dev --turbopack",
    "e2e:db:up": "docker compose -f docker-compose.e2e.yml up -d --wait",
    "e2e:db:down": "docker compose -f docker-compose.e2e.yml down -v",
    "e2e:db:prepare": "dotenv -e config/e2e.env -e config/e2e.local.env -o -- tsx scripts/assert-ephemeral-db.ts && dotenv -e config/e2e.env -e config/e2e.local.env -o -- prisma migrate deploy && dotenv -e config/e2e.env -e config/e2e.local.env -o -- sh -c 'tsx \"$E2E_SEED_SCRIPT\"'",
    "e2e:setup": "npm run e2e:db:up && npm run e2e:db:prepare",
    "test:e2e:only": "dotenv -e config/e2e.env -e config/e2e.local.env -o -- playwright test",
    "check": "biome check && tsc --noEmit",
    "test:unit": "dotenv -e .env.development -- vitest run",
    "test:all": "npm run check && npm run test:unit && npm run test:e2e",
    "build:e2e": "dotenv -e config/e2e.env -e config/e2e.local.env -o -- tsx scripts/assert-ephemeral-db.ts && dotenv -e config/e2e.env -e config/e2e.local.env -o -- next build",
    "start:e2e": "dotenv -e config/e2e.env -e config/e2e.local.env -o -- next start",
    "test:e2e:dev": "npm run e2e:setup && dotenv -e config/e2e.env -e config/e2e.local.env -o -v E2E_SERVER=dev -- playwright test"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.16.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-pdf/renderer": "^4.3.2",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/blob": "^2.0.0",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.544.0",
    "mermaid": "^11.15.0",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.1",
    "next": "15.5.9",
    "next-auth": "^4.24.11",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.65.0",
    "recharts": "^3.6.0",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@mswjs/http-middleware": "^0.10.3",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "dotenv-cli": "^11.0.0",
    "jsdom": "^27.4.0",
    "msw": "^2.12.7",
    "prisma": "^6.16.2",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.0.16"
  }
}
