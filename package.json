{
  "name": "opustrack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && next build --turbopack",
    "start": "next start",
    "dev": "docker compose up",
    "dev:host": "node scripts/with-env.mjs dev -- next dev --turbopack",
    "dev:next": "next dev --turbopack",
    "stack:down": "docker compose down",
    "build:prod": "node scripts/with-env.mjs prod -- next build --turbopack",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose stop db",
    "db:init": "node scripts/with-env.mjs dev -- tsx scripts/db-init.ts",
    "db:migrate": "node scripts/with-env.mjs dev -- prisma migrate dev",
    "db:studio": "node scripts/with-env.mjs dev -- prisma studio",
    "db:reset": "node scripts/with-env.mjs dev -- prisma migrate reset --skip-seed && npm run db:init",
    "check": "biome check && tsc --noEmit",
    "format": "biome format --write",
    "test": "node scripts/with-env.mjs dev -- vitest",
    "test:unit": "node scripts/with-env.mjs dev -- vitest run",
    "test:coverage": "node scripts/with-env.mjs dev -- vitest run --coverage",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:dev": "node scripts/e2e.mjs --dev",
    "test:e2e:only": "node scripts/with-env.mjs e2e -- playwright test",
    "test:all": "npm run check && npm run test:unit && npm run test:e2e",
    "e2e:up": "docker compose -f docker-compose.e2e.yml up -d --wait && node scripts/with-env.mjs e2e -- tsx scripts/e2e-prepare.ts",
    "e2e:down": "docker compose -f docker-compose.e2e.yml down -v",
    "e2e:start": "node scripts/with-env.mjs e2e -- next start",
    "test:e2e:ui": "node scripts/e2e.mjs --dev --ui",
    "lint": "biome check",
    "e2e:dev": "node scripts/with-env.mjs e2e -- next dev --turbopack",
    "db:prod:status": "node scripts/db-prod.mjs status",
    "db:prod:migrate": "node scripts/db-prod.mjs migrate",
    "db:prod:seed": "node scripts/db-prod.mjs seed",
    "db:prod:reset": "node scripts/db-prod.mjs reset",
    "db:prod:studio": "node scripts/db-prod.mjs studio"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.16.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-pdf/renderer": "^4.3.2",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/blob": "^2.0.0",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.544.0",
    "mermaid": "^11.15.0",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.1",
    "next": "15.5.9",
    "next-auth": "^4.24.11",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.65.0",
    "recharts": "^3.6.0",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@mswjs/http-middleware": "^0.10.3",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "dotenv-cli": "^11.0.0",
    "jsdom": "^27.4.0",
    "msw": "^2.12.7",
    "prisma": "^6.16.2",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=22"
  }
}
